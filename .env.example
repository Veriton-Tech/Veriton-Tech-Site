# Environment Variables Example
#
# For LOCAL DEVELOPMENT: Copy this to .env.local
# For DOCKER PRODUCTION: Copy this to .env next to docker-compose.frontend.yml
#
# Both files are gitignored for security

# Caddy Network Configuration (for Docker)
CADDY_NETWORK_NAME=hojaega-backend_hojaega_net

# Where contact form messages are delivered
EMAIL_RECEIVER=info@veriton.si

# --- Preferred: SMTP for info@veriton.si (your mail host) ---
# SMTP_HOST=mail.veriton.si
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@veriton.si
# SMTP_PASS=your-mailbox-password

# --- Or Gmail / Google Workspace SMTP ---
# EMAIL_USER=your-account@gmail.com
# EMAIL_APP_PASSWORD=your_16_char_app_password
